# Backend API Configuration
# Base URL for the Xether AI backend API
#XETHER_BACKEND_API_BASE_URL=https://api.xether.ai

# For local development, use:
XETHER_BACKEND_API_BASE_URL=http://localhost:8000/api/v1

# Next.js Public API URL (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: API key for backend authentication
XETHER_BACKEND_API_KEY=

# OAuth2 Configuration (Generic SSO)
# Generic OAuth2 client credentials for enterprise SSO
XETHER_OAUTH_CLIENT_ID=
XETHER_OAUTH_CLIENT_SECRET=
XETHER_OAUTH_SCOPES=openid profile email
XETHER_OAUTH_RESPONSE_TYPE=code

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Set to 'false' to hide the Google OAuth button (default: shown)
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
XETHER_GOOGLE_CLIENT_ID=
XETHER_GOOGLE_CLIENT_SECRET=

# GitHub OAuth Configuration
# Get credentials from: https://github.com/settings/developers
# Set to 'false' to hide the GitHub OAuth button (default: shown)
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=true
XETHER_GITHUB_CLIENT_ID=
XETHER_GITHUB_CLIENT_SECRET=

# GitLab OAuth Configuration
# Get credentials from: https://gitlab.com/-/profile/applications
# Set to 'false' to hide the GitLab OAuth button (default: shown)
NEXT_PUBLIC_GITLAB_OAUTH_ENABLED=true
XETHER_GITLAB_CLIENT_ID=
XETHER_GITLAB_CLIENT_SECRET=
XETHER_GITLAB_URL=https://gitlab.com

# Application URLs
# URL of the main application (where users are redirected after auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Custom Backend API Paths
# Override default paths if your backend uses different endpoints
NEXT_PUBLIC_LOGIN_URL=/login
# XETHER_AUTH_REGISTER_PATH=/auth/register
# XETHER_AUTH_FORGOT_PASSWORD_PATH=/auth/forgot-password
# XETHER_OAUTH_AUTHORIZE_PATH=/oauth/authorize
# XETHER_OAUTH_TOKEN_PATH=/oauth/token
# XETHER_CONTACT_FORM_PATH=/forms/contact
# XETHER_DEMO_REQUEST_PATH=/forms/demo
# XETHER_CTA_EMAIL_PATH=/forms/cta

# Node Environment
NODE_ENV=development

