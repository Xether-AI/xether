# ==============================================================================
# Xether AI Website — Environment Variables Template
# Copy to `.env` (or `.env.local`) for local development.
# NEVER commit `.env`, API keys, or OAuth secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Website & Companion App URLs
# ------------------------------------------------------------------------------
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_APP_URL=http://localhost:3001
NEXT_PUBLIC_DOCS_URL=http://localhost:3002
# Deployed (Staging / Production):
# NEXT_PUBLIC_APP_URL=https://xether.ai
# NEXT_PUBLIC_FRONTEND_APP_URL=https://app.xether.ai
# NEXT_PUBLIC_DOCS_URL=https://docs.xether.ai

# ------------------------------------------------------------------------------
# 2. Backend API Addresses
# ------------------------------------------------------------------------------
# Local development:
XETHER_BACKEND_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000
XETHER_ARTIFACT_STORAGE_URL=http://localhost:8080
XETHER_PIPELINE_API_URL=http://localhost:8002
XETHER_METERING_API_URL=http://localhost:9091
# Deployed (Staging / Production):
# XETHER_BACKEND_API_BASE_URL=https://api.xether.ai/api/v1
# NEXT_PUBLIC_API_URL=https://api.xether.ai
# XETHER_ARTIFACT_STORAGE_URL=
# XETHER_PIPELINE_API_URL=
# XETHER_METERING_API_URL=

# ------------------------------------------------------------------------------
# 3. Server-Side Secrets & API Keys (NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
XETHER_BACKEND_API_KEY=

# ------------------------------------------------------------------------------
# 4. Enterprise OAuth2 & Social Auth (leave secrets empty in git)
# ------------------------------------------------------------------------------
XETHER_OAUTH_CLIENT_ID=
XETHER_OAUTH_CLIENT_SECRET=
XETHER_OAUTH_SCOPES=openid profile email
XETHER_OAUTH_RESPONSE_TYPE=code

NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
XETHER_GOOGLE_CLIENT_ID=
XETHER_GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=false
XETHER_GITHUB_CLIENT_ID=
XETHER_GITHUB_CLIENT_SECRET=

NEXT_PUBLIC_GITLAB_OAUTH_ENABLED=false
XETHER_GITLAB_CLIENT_ID=
XETHER_GITLAB_CLIENT_SECRET=
XETHER_GITLAB_URL=https://gitlab.com

# ------------------------------------------------------------------------------
# 5. Analytics & Runtime
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NODE_ENV=development
